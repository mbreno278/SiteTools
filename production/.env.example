# =============================================================================
# SiteTools — exemplo de variáveis de ambiente
# Copie para ".env" na raiz do projeto e ajuste os valores.
# NUNCA versione o arquivo .env com segredos reais.
# =============================================================================

APP_NAME=SiteTools
APP_ENV=production
APP_DEBUG=false
# No WAMP, exemplo: /projetos/SiteTools  |  Em produção na raiz: (vazio)
BASE_URL=
# URL completa opcional (senão é inferida)
# APP_URL=http://localhost/projetos/SiteTools

TIMEZONE=America/Sao_Paulo
ADMIN_SESSION_NAME=sitetools_admin

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
MAIL_FROM=noreply@sitetools.local

# -----------------------------------------------------------------------------
# Uploads e processos
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=31457280
PROCESS_TIMEOUT=180

# Token para rotinas de limpeza via web (deixe vazio para só CLI)
CLEANUP_TOKEN=

# Caminhos opcionais dos binários (deixe vazio para auto-detect)
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.05.0\bin\gswin64c.exe
# QPDF_PATH=
# YTDLP_PATH=
