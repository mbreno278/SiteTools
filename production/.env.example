# =============================================================================
# SiteTools — modelo de variáveis de ambiente (PRODUÇÃO)
# 1) Copie este arquivo para ".env" na raiz de production/
# 2) Preencha com os valores reais do servidor
# 3) NUNCA faça commit do arquivo .env
# =============================================================================

APP_NAME=WebTools
APP_ENV=production
APP_DEBUG=false
BASE_URL=https://www.webtools.com
# APP_URL=https://www.webtools.com

TIMEZONE=America/Sao_Paulo
ADMIN_SESSION_NAME=sitetools_admin

# -----------------------------------------------------------------------------
# Banco de dados (obrigatório em produção)
# -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=COLOQUE_SENHA_FORTE_AQUI

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
MAIL_FROM=noreply@seudominio.com

# -----------------------------------------------------------------------------
# Uploads e processos
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=31457280
PROCESS_TIMEOUT=180

# Token aleatório para rotinas de limpeza via HTTP (deixe vazio = só CLI)
CLEANUP_TOKEN=

# Caminhos dos binários no servidor Linux (ajuste se não estiverem no PATH)
# GHOSTSCRIPT_PATH=/usr/bin/gs
# QPDF_PATH=/usr/bin/qpdf
# YTDLP_PATH=/usr/local/bin/yt-dlp
# LIBREOFFICE_PATH=/usr/bin/soffice
# FFMPEG_PATH=/usr/bin/ffmpeg
