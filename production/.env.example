# =============================================================================
# SiteTools — variáveis de ambiente (produção)
# Copie para ".env" na raiz do projeto e preencha os valores.
# NUNCA versione o arquivo .env com segredos reais.
# =============================================================================

APP_NAME=SiteTools
APP_ENV=production
APP_DEBUG=false

# Vazio = site na raiz do domínio (https://seudominio.com)
# Se estiver em subpasta: BASE_URL=/minha-pasta
BASE_URL=

# URL completa opcional (senão é inferida a partir do host + BASE_URL)
# APP_URL=https://seudominio.com

TIMEZONE=America/Sao_Paulo
ADMIN_SESSION_NAME=sitetools_admin

# -----------------------------------------------------------------------------
# Banco de dados (obrigatório em produção)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webtools__sitetools
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
MAIL_FROM=noreply@seudominio.com

# -----------------------------------------------------------------------------
# Uploads e processos
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=31457280
PROCESS_TIMEOUT=180

# Token forte para rotinas de limpeza via HTTP (deixe vazio para só CLI)
CLEANUP_TOKEN=

# Caminhos opcionais dos binários (deixe vazio para auto-detect no PATH)
# LIBREOFFICE_PATH=/usr/bin/soffice
# GHOSTSCRIPT_PATH=/usr/bin/gs
# QPDF_PATH=/usr/bin/qpdf
# YTDLP_PATH=/usr/local/bin/yt-dlp
